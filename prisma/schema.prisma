generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  releaseYear Int
  runtime     Int // minutes
  watched     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Movies this one depends on (must be watched first)
  prerequisites Movie[] @relation("MoviePrerequisites")
  // Movies that depend on this one
  dependents    Movie[] @relation("MoviePrerequisites")
}

model Cinema {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  bundleSizes String // JSON array string, e.g. "[1,3,4]"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
